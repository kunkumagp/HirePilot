APP_NAME=HirePilot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Postgres is recommended for a multi-user deployment.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hirepilot
DB_USERNAME=hirepilot
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_ENCRYPT=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional notification channels (only if you use them)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_ORIGINS=https://example.com

JOBHUNTER_USER_AGENT="HirePilot/1.0 (+https://example.com/bot)"
JOBHUNTER_USE_QUEUE=true
